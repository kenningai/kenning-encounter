# Copy to .env (or export in your shell) before `docker compose up`.
# Used for both the Neo4j NEO4J_AUTH and Kenning Encounter's NEO4J_PASSWORD, so the two
# components share one credential.
NEO4J_KENNING_ENCOUNTER_PASSWORD=change-me-to-a-strong-password

# Neo4j's host ports. Every published port is bound to 127.0.0.1; a
# host-only binding cannot share a port with another local Neo4j (Neo4j
# Desktop, say), so move these if one is already listening.
# NEO4J_KENNING_ENCOUNTER_HTTP_PORT=7474
# NEO4J_KENNING_ENCOUNTER_BOLT_PORT=7687
